# Django Secret Key & Security Config
DJANGO_SECRET_KEY=replace-with-your-strong-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

# Database Configuration (Service Adapter Pattern)
# Default is local SQLite. To switch to PostgreSQL in production, uncomment and set DATABASE_URL:
# DATABASE_URL=postgres://blood_pulse_user:your_password@localhost:5432/blood_pulse_db

# CORS Configuration
# Set to True only for local debugging. Leave False in production.
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated extra allowed origins (e.g. your deployed web app domain)
# CORS_ALLOWED_ORIGINS=https://bloodpulse-backend.onrender.com,https://your-custom-domain.com


# Field Encryption (Generated via Fernet.generate_key())
FIELD_ENCRYPTION_KEY=your_generated_fernet_key_here

# Email Configuration (brevo_api | console | locmem)
# In production, set EMAIL_PROVIDER=brevo_api with your Brevo REST API credentials.
EMAIL_PROVIDER=console
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email_here
BREVO_SENDER_NAME=BloodPulse
DEFAULT_FROM_EMAIL=BloodPulse <your_verified_sender_email_here>


# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5

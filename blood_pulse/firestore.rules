rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function checking if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function checking if user is the resource owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function checking if user has custom admin claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ── 1. USER PROFILES COLLECTION (/users/{userId}) ─────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bloodGroup']) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── 2. BLOOD REQUESTS COLLECTION (/requests/{requestId}) ──────────────────
    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() 
        && (resource.data.requesterUid == request.auth.uid || isAdmin());
    }

    // ── 3. CHAT ROOMS (/chat_rooms/{roomId}/messages/{messageId}) ─────────────
    match /chat_rooms/{roomId} {
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }
    }

    // ── 4. CHATS (DEPRECATED - FULLY LOCKED DOWN) ─────────────────────────────
    match /chats/{chatId} {
      allow read, write: if false;
      
      match /{allChildren=**} {
        allow read, write: if false;
      }
    }

    // ── 5. LIVE JOURNEY TRACKING (/tracking/{matchId}) ───────────────────────
    match /tracking/{matchId} {
      // Only authenticated participants (donor or requester) can read the tracking doc
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.donorUid || 
        request.auth.uid == resource.data.requesterUid || 
        isAdmin()
      );

      // Document is initialized by backend server via Admin SDK, or created by participants if authorized
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.donorUid || 
        request.auth.uid == request.resource.data.requesterUid || 
        isAdmin()
      );

      // Donor can update donorLocation, etaMinutes, distanceKm, status, updatedAt
      // Requester can update requesterLocation, updatedAt
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.donorUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['donorLocation', 'etaMinutes', 'distanceKm', 'status', 'updatedAt'])) ||
        (request.auth.uid == resource.data.requesterUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requesterLocation', 'updatedAt'])) ||
        isAdmin()
      );

      // Only participants or Admin can delete upon journey termination
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.donorUid || 
        request.auth.uid == resource.data.requesterUid || 
        isAdmin()
      );
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function checking if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function checking if user is the resource owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function checking if user has custom admin claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ── 1. USER PROFILES COLLECTION (/users/{userId}) ─────────────────────────
    match /users/{userId} {
      // Publicly readable for authenticated users (required for donor matching & search)
      allow read: if isAuthenticated();

      // Enforce Admin-Lock Rule on bloodGroup field
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bloodGroup']) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── 2. BLOOD REQUESTS COLLECTION (/requests/{requestId}) ──────────────────
    match /requests/{requestId} {
      allow read: if isAuthenticated();
      
      // Enforce AI Trust Score Gatekeeper (aiTrustScore >= 60) prior to publishing
      allow create: if isAuthenticated() 
        && request.resource.data.aiTrustScore >= 60
        && request.resource.data.patientName != null
        && request.resource.data.bloodGroup != null
        && request.resource.data.location != null;

      // Only request creator or admin can update status (e.g. Active -> Fulfilled)
      allow update, delete: if isAuthenticated() 
        && (resource.data.requesterUid == request.auth.uid || isAdmin());
    }

    // ── 3. CHAT THREADS & MESSAGES (/chats/{chatId}/messages/{messageId}) ─────
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
